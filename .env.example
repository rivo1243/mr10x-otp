# ── Mr10x OTP — Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in all required values before running.
# Never commit .env to version control.

# ── Admin ─────────────────────────────────────────────────────────────────────
# REQUIRED — strong random password for the admin panel
# Generate: openssl rand -base64 32
ADMIN_PASS=

# ── App secret ────────────────────────────────────────────────────────────────
# REQUIRED — used for password hashing; changing this invalidates all sessions
# Generate: openssl rand -hex 32
SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin allowed to call the API, e.g. https://your-seller-dashboard.com
# Leave empty to disable CORS (API not accessible from browsers)
CORS_ORIGIN=

# ── IMAP password encryption ──────────────────────────────────────────────────
# REQUIRED for encrypting stored IMAP passwords (AES-256-CBC)
# Must be exactly 64 hex characters (= 32 bytes)
# Generate: openssl rand -hex 32
IMAP_ENCRYPT_KEY=

# ── App URL ───────────────────────────────────────────────────────────────────
# Public base URL of this service (used in email links, etc.)
BASE_URL=https://your-deployment.up.railway.app

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Mailjet (transactional email) ─────────────────────────────────────────────
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=noreply@yourdomain.com

# ── Admin notifications ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
